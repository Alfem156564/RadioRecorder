<Window x:Class="RadioRecorder.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Radio Recorder"
        Height="800"
        Width="1100"
        MinHeight="650"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0"
                Background="#17324D"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Radio Recorder"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Grabación automática de estaciones de radio"
                               FontSize="14"
                               Foreground="#D5E2EF"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#DCE8F2"
                        CornerRadius="8"
                        Padding="12,8"
                        VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusIndicator"
                                 Width="10"
                                 Height="10"
                                 Fill="#64748B"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>

                        <TextBlock x:Name="StatusText"
                                   Text="Detenido"
                                   FontWeight="SemiBold"
                                   Foreground="#17324D"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Selección y controles -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Origen de las estaciones"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#17324D"
                               Margin="0,0,0,10"/>

                    <ComboBox x:Name="ProviderComboBox"
                              Width="320"
                              Height="36"
                              HorizontalAlignment="Left"
                              SelectedIndex="1"
                              FontSize="14">

                        <ComboBoxItem Content="HardcodedRadioStationProvider"
                                      Tag="Hardcoded"/>

                        <ComboBoxItem Content="JsonFileRadioStationProvider"
                                      Tag="JsonFile"/>

                        <ComboBoxItem Content="SqlRadioStationProvider"
                                      Tag="Sql"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button x:Name="StartButton"
                            Content="▶  Iniciar grabaciones"
                            Width="175"
                            Height="42"
                            Background="#16845B"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="StartButton_Click"/>

                    <Button x:Name="RefreshStationsButton"
                            Content="↻  Actualizar estaciones"
                            Width="180"
                            Height="42"
                            Background="#2563A6"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsEnabled="False"
                            Margin="10,0,0,0"
                            Click="RefreshStationsButton_Click"/>

                    <Button x:Name="StopButton"
                            Content="■  Detener grabaciones"
                            Width="180"
                            Height="42"
                            Background="#C83C43"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Margin="10,0,0,0"
                            Click="StopButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actividad del sistema y errores acumulados -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Actividad -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,10,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Actividad del sistema"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#17324D"
                               Margin="0,0,0,14"/>

                    <TextBox x:Name="LogTextBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="#111827"
                             Foreground="#D1FAE5"
                             BorderThickness="0"
                             Padding="12"
                             Text="Sistema iniciado. Esperando instrucciones..."/>
                </Grid>
            </Border>

            <!-- Errores -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="16"
                    Margin="10,0,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Errores detectados"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#17324D"/>

                        <TextBlock Text="Conteo acumulado desde el inicio"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="ErrorsDataGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding RecordingErrors}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              Background="White"
                              BorderThickness="0"
                              FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Estación"
                                                Binding="{Binding Station}"
                                                Width="105"/>
                            <DataGridTextColumn Header="Error"
                                                Binding="{Binding Error}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Veces"
                                                Binding="{Binding Count}"
                                                Width="48"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Estado visual de todas las estaciones -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Estado de las estaciones"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#17324D"/>
                    <TextBlock x:Name="StationStatusRefreshText"
                               Text="  •  Actualización automática cada 15 segundos"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#64748B"
                               Margin="8,2,0,0"/>
                </StackPanel>

                <DataGrid x:Name="StationStatusDataGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding StationStatuses}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          Background="White"
                          BorderThickness="0"
                          FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Estado" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="14" Height="14" HorizontalAlignment="Center"
                                             Stroke="#64748B" StrokeThickness="0.8">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#FFFFFF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Grabando">
                                                        <Setter Property="Fill" Value="#16A34A"/>
                                                        <Setter Property="Stroke" Value="#15803D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Error de grabación">
                                                        <Setter Property="Fill" Value="#DC2626"/>
                                                        <Setter Property="Stroke" Value="#B91C1C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="En espera">
                                                        <Setter Property="Fill" Value="#FFFFFF"/>
                                                        <Setter Property="Stroke" Value="#94A3B8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Estación"
                                            Binding="{Binding Station}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="Frecuencia"
                                            Binding="{Binding Frequency}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Ciudad"
                                            Binding="{Binding City}"
                                            Width="1.5*"/>
                        <DataGridTextColumn Header="Situación"
                                            Binding="{Binding Status}"
                                            Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Pie -->
        <TextBlock Grid.Row="4"
                   Text="Radio Recorder • Control de grabaciones"
                   Foreground="#64748B"
                   FontSize="11"
                   HorizontalAlignment="Right"/>
    </Grid>
</Window>
